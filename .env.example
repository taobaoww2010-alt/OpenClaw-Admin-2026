# OpenClaw Admin - Environment Example
# Copy this file to .env and fill in your values

# Application
VITE_APP_TITLE=OpenClaw Admin
PORT=3000
DEV_PORT=3001

# OpenClaw Gateway (required)
OPENCLAW_WS_URL=ws://127.0.0.1:18789
OPENCLAW_AUTH_TOKEN=your-auth-token
OPENCLAW_AUTH_PASSWORD=your-auth-password

# Admin Authentication (required)
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me-to-secure-password

# Hermes Agent (optional)
HERMES_WEB_URL=http://localhost:9119
HERMES_API_URL=http://localhost:8642
HERMES_API_KEY=your-hermes-api-key

# TTS Settings
VITE_TTS_ENABLED=true
VITE_TTS_AUTO_PLAY=false
VITE_TTS_VOICE=zh-CN-XiaoxiaoNeural
VITE_TTS_RATE=1.0
VITE_TTS_VOLUME=1.0
VITE_TTS_PITCH=1.0

# Telegram Bot (optional - for alert push)
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# TELEGRAM_CHAT_ID=your-telegram-chat-id

# System
HERMES_AUTO_START_DASHBOARD=false
LOG_LEVEL=INFO
